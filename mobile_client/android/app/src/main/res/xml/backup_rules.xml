<?xml version="1.0" encoding="utf-8"?>
<!-- A5.1 (FR5/NFR4): Auto Backup rules for Android 11 and older (android:fullBackupContent).
     Everything is excluded; with android:allowBackup="false" the app is not backed up at all.
     Android 12+ uses data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
