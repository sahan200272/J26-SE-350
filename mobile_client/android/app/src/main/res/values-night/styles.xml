<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Echo Vault uses one dark brand theme regardless of the system Dark Mode setting. -->
    <!-- Theme applied to the Android Window while the process is starting. Shows the branded
         launch background until the Flutter engine draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme behind the Flutter UI once it is running: near-black, so there is no white
         flash between the launch window and the first Flutter frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ev_black</item>
    </style>
</resources>
