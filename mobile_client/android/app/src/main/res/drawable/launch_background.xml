<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window before Flutter draws (Android 11 and older): near-black with the
     Echo Vault Keyhole Wave mark centred, matching the first frame of the in-app splash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ev_black" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_symbol" />
    </item>
</layer-list>
