<?xml version="1.0" encoding="utf-8"?>
<!-- Echo Vault adaptive launcher icon (Android 8+), from the brand kit
     01-app-icon/android-adaptive. The monochrome layer (Android 13 themed icons) is the
     brand kit's 05-monochrome white symbol placed with the same geometry. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
