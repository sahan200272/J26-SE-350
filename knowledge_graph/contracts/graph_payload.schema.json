{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphPayload",
  "description": "Payload format for entities and relationships extracted from voice conversations to update the personal knowledge graph.",
  "type": "object",
  "required": [
    "source",
    "entities",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0",
      "description": "Schema version of the payload contract. Defaults to '1.0'."
    },
    "source": {
      "type": "string",
      "description": "Identifier for the conversation transcript or speech session, e.g. voice_convo_20261011_1430."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 timestamp of the conversation."
    },
    "entities": {
      "type": "array",
      "description": "List of extracted entities to upsert into the graph.",
      "items": {
        "$ref": "#/$defs/Entity"
      }
    },
    "relationships": {
      "type": "array",
      "description": "List of relationships connecting the extracted entities.",
      "items": {
        "$ref": "#/$defs/Relationship"
      }
    }
  },
  "$defs": {
    "OpType": {
      "type": "string",
      "enum": [
        "add",
        "update",
        "retract"
      ],
      "default": "add",
      "description": "Operation signal: 'add' (create if missing), 'update' (correction), or 'retract' (cancellation / negation)."
    },
    "EntityRef": {
      "type": "object",
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "Node label. Tier 1: Person, Team, Organization, Project, Task, Meeting, Decision, Issue, Question, Deadline, Location, Document. Tier 2: Goal, Idea, Tool, Metric, Event, Topic, Concept, Preference, Note, Conversation, Item. Unrecognized labels fall back to Concept."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name of the referenced entity (non-empty after whitespace strip)."
        }
      },
      "additionalProperties": false
    },
    "Entity": {
      "type": "object",
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "Node label. Standard labels: Person, Team, Organization, Project, Task, Meeting, Decision, Issue, Question, Deadline, Location, Document, Goal, Idea, Tool, Metric, Event, Topic, Concept, Preference, Note, Conversation, Item. Unrecognized labels fall back to Concept with props['original_type']."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name of the entity (non-empty after whitespace strip)."
        },
        "op": {
          "$ref": "#/$defs/OpType"
        },
        "props": {
          "type": "object",
          "description": "Whitelisted entity attributes. Values must be scalar (str, int, float, bool) except 'aliases' which is a list of non-empty strings.",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "open",
                "in progress",
                "blocked",
                "done",
                "cancelled",
                "planned",
                "active",
                "agreed",
                "superseded",
                "answered"
              ],
              "description": "Lifecycle state (e.g. open, in progress, blocked, done, cancelled, planned, active, agreed, superseded, answered)."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ],
              "description": "Priority ranking (low, medium, high, urgent)."
            },
            "progress": {
              "type": ["string", "number", "boolean"],
              "description": "Completion progress percentage or indicator."
            },
            "date": {
              "type": ["string", "number", "boolean"],
              "description": "ISO date string (YYYY-MM-DD)."
            },
            "time": {
              "type": ["string", "number", "boolean"],
              "description": "Time string (HH:MM:SS)."
            },
            "duration": {
              "type": ["string", "number", "boolean"],
              "description": "Duration string or minutes (e.g. 45m)."
            },
            "recurrence": {
              "type": ["string", "number", "boolean"],
              "description": "Recurrence pattern (e.g. weekly, biweekly)."
            },
            "value": {
              "type": ["string", "number", "boolean"],
              "description": "Metric or parameter numerical value."
            },
            "unit": {
              "type": ["string", "number", "boolean"],
              "description": "Unit of measurement (e.g. ms, %, MB)."
            },
            "title": {
              "type": ["string", "number", "boolean"],
              "description": "Document or meeting title."
            },
            "severity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "description": "Issue severity level (low, medium, high, critical)."
            },
            "kind": {
              "type": ["string", "number", "boolean"],
              "description": "Sub-category classifier (e.g. sister, mother, grocery)."
            },
            "description": {
              "type": ["string", "number", "boolean"],
              "description": "Detailed explanation or text content."
            },
            "rationale": {
              "type": ["string", "number", "boolean"],
              "description": "Justification behind a decision."
            },
            "quote": {
              "type": ["string", "number", "boolean"],
              "description": "Verbatim quote from spoken audio."
            },
            "timestamp": {
              "type": ["string", "number", "boolean"],
              "description": "ISO-8601 timestamp string."
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Extraction confidence score between 0.0 and 1.0."
            },
            "label": {
              "type": ["string", "number", "boolean"],
              "description": "Original relationship type preserved when normalized to RELATED_TO."
            },
            "original_type": {
              "type": ["string", "number", "boolean"],
              "description": "Original entity type preserved when normalized to Concept."
            },
            "age": {
              "type": ["integer", "number", "string"],
              "description": "Age of a person in years."
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "List of alternate names or nicknames."
            },
            "email": {
              "type": "string",
              "description": "Email address string."
            },
            "phone": {
              "type": "string",
              "description": "Phone number string."
            },
            "birthday": {
              "type": "string",
              "description": "ISO date string for birthday (YYYY-MM-DD)."
            },
            "sensitivity": {
              "type": "string",
              "enum": [
                "normal",
                "private"
              ],
              "description": "Privacy classification flag."
            },
            "speaker": {
              "type": "string",
              "description": "Speaker identity identifier in multi-speaker audio."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Relationship": {
      "type": "object",
      "required": [
        "from",
        "type",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/EntityRef",
          "description": "Source entity of the directed relationship."
        },
        "type": {
          "type": "string",
          "description": "Relationship type (45 standard types). Unrecognized types or invalid directions fall back to RELATED_TO."
        },
        "to": {
          "$ref": "#/$defs/EntityRef",
          "description": "Target entity of the directed relationship."
        },
        "op": {
          "$ref": "#/$defs/OpType"
        },
        "props": {
          "type": "object",
          "description": "Whitelisted relationship attributes with scalar values.",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "open",
                "in progress",
                "blocked",
                "done",
                "cancelled",
                "planned",
                "active",
                "agreed",
                "superseded",
                "answered"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            },
            "progress": { "type": ["string", "number", "boolean"] },
            "date": { "type": ["string", "number", "boolean"] },
            "time": { "type": ["string", "number", "boolean"] },
            "duration": { "type": ["string", "number", "boolean"] },
            "recurrence": { "type": ["string", "number", "boolean"] },
            "value": { "type": ["string", "number", "boolean"] },
            "unit": { "type": ["string", "number", "boolean"] },
            "title": { "type": ["string", "number", "boolean"] },
            "severity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "kind": { "type": ["string", "number", "boolean"] },
            "description": { "type": ["string", "number", "boolean"] },
            "rationale": { "type": ["string", "number", "boolean"] },
            "quote": { "type": ["string", "number", "boolean"] },
            "timestamp": { "type": ["string", "number", "boolean"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "label": { "type": ["string", "number", "boolean"] },
            "original_type": { "type": ["string", "number", "boolean"] },
            "age": { "type": ["integer", "number", "string"] },
            "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "email": { "type": "string" },
            "phone": { "type": "string" },
            "birthday": { "type": "string" },
            "sensitivity": { "type": "string", "enum": ["normal", "private"] },
            "speaker": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
